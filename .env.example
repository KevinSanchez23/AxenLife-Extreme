# Backend solamente. Nunca usar prefijo VITE_ para secretos.
NODE_ENV=development
PORT=3001
PUBLIC_SITE_URL=http://localhost:5173/
STRIPE_SECRET_KEY=sk_test_REEMPLAZAR
STRIPE_WEBHOOK_SECRET=whsec_REEMPLAZAR
GOOGLE_SHEETS_WEB_APP_URL=https://script.google.com/macros/s/REEMPLAZAR/exec
# Generar 32 bytes aleatorios en hexadecimal; copiar también a Script Properties.
GOOGLE_SHEETS_SHARED_SECRET=REEMPLAZAR_POR_UN_SECRETO_ALEATORIO
# Límite técnico en centavos; bajar según las reglas del viaje.
MAX_AMOUNT_CENTS=99999999
# 0 directo. 1 solo si existe exactamente un proxy confiable y Node no es público.
TRUST_PROXY_HOPS=0
